<%- include('partials/head', { title: 'Login' }) %>

<main class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="card w-full max-w-sm">
    <div class="card-header">
      <h1 class="card-title text-primary">Al's Flowers</h1>
      <p class="card-description">Staff sign in</p>
    </div>
    <div class="card-content">
      <form class="space-y-4" action="/login" method="POST">
        <div class="space-y-2">
          <label class="label" for="email">Email</label>
          <input class="input" id="email" name="email" type="text" placeholder="you@example.com" autofocus required />
        </div>
        <div class="space-y-2">
          <label class="label" for="password">Password</label>
          <input class="input" id="password" name="password" type="password" placeholder="••••••••" required />
        </div>
        <button type="submit" class="btn-default w-full">Sign in</button>
      </form>
    </div>
  </div>
</main>

</body>
</html>
