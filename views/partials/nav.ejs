<% var path = typeof currentNav !== 'undefined' ? currentNav : ''; %>
<header class="app-header">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <a href="/orders" class="flex items-center gap-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary text-xs font-bold text-primary-foreground">AF</span>
        <span class="hidden font-semibold sm:inline-block">Al's Flowers</span>
      </a>
      <nav class="tabs-list h-9" aria-label="Orders navigation">
        <a href="/orders" class="<%= path === '/orders' ? 'tabs-trigger-active' : 'tabs-trigger-inactive' %>">All orders</a>
        <a href="/orders/today" class="<%= path === '/orders/today' ? 'tabs-trigger-active' : 'tabs-trigger-inactive' %>">Today</a>
        <a href="/orders/tomorrow" class="<%= path === '/orders/tomorrow' ? 'tabs-trigger-active' : 'tabs-trigger-inactive' %>">Tomorrow</a>
      </nav>
    </div>
    <a href="/logout" class="btn-outline btn-sm">Log out</a>
  </div>
</header>
