<%- include('head', { title: typeof pageTitle !== 'undefined' ? pageTitle : 'Orders' }) %>
<%- include('nav') %>

<main class="app-main">
  <div class="page-heading">
    <h1 class="page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Orders' %></h1>
    <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
      <p class="page-description"><%= pageSubtitle %></p>
    <% } else { %>
      <p class="page-description">Manage fulfillment, printing, and workflow.</p>
    <% } %>
  </div>

  <% var s = typeof summary !== 'undefined' ? summary : { total: 0, arrangements: 0, unprinted: 0, pending: 0 }; %>
  <div class="stats-grid">
    <div class="stat-item">
      <p class="stat-item-label">In view</p>
      <p class="stat-item-value"><%= s.total %></p>
    </div>
    <div class="stat-item">
      <p class="stat-item-label">Arrangements</p>
      <p class="stat-item-value text-amber-600"><%= s.arrangements %></p>
    </div>
    <div class="stat-item">
      <p class="stat-item-label">Need print</p>
      <p class="stat-item-value text-sky-600"><%= s.unprinted %></p>
    </div>
    <div class="stat-item">
      <p class="stat-item-label">Pending</p>
      <p class="stat-item-value text-orange-600"><%= s.pending %></p>
    </div>
  </div>

  <% var filters = [
    { key: 'active', label: 'Active' },
    { key: 'all', label: 'All' },
    { key: 'arrangement', label: 'Arrangements' },
    { key: 'other', label: 'Other' },
    { key: 'complete', label: 'Complete' }
  ]; %>
  <% var baseUrl = typeof listBaseUrl !== 'undefined' ? listBaseUrl : '/orders'; %>
  <% var currentFilter = typeof filter !== 'undefined' ? filter : 'active'; %>

  <div class="card">
    <div class="card-header pb-4">
      <h2 class="card-title text-base">Filters &amp; search</h2>
      <p class="card-description">Narrow the list or jump to a specific date.</p>
    </div>
    <div class="card-content space-y-4">
      <div class="tabs-list flex-wrap h-auto gap-1 p-1">
        <% for (var fi = 0; fi < filters.length; fi++) { %>
          <% var f = filters[fi]; %>
          <a href="<%= baseUrl %>?filter=<%= f.key %>"
             class="<%= currentFilter === f.key ? 'tabs-trigger-active' : 'tabs-trigger-inactive' %>">
            <%= f.label %>
          </a>
        <% } %>
      </div>

      <% if (typeof showDateSearch === 'undefined' || showDateSearch) { %>
        <div class="separator-h"></div>
        <div class="toolbar-grid">
          <form action="/orders/search" method="post" class="space-y-2">
            <label class="label" for="order_search">Search</label>
            <div class="flex gap-2">
              <input class="input" id="order_search" name="order" placeholder="Order # or customer name" type="text" autocomplete="off" />
              <button type="submit" class="btn-default shrink-0">Search</button>
            </div>
          </form>
          <form action="" method="post" id="date_form" class="space-y-2">
            <label class="label" for="order_date">By date</label>
            <div class="flex gap-2">
              <input class="input" id="order_date" name="date" type="date" />
              <button type="button" id="search_day" class="btn-outline shrink-0">Go</button>
            </div>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header flex flex-row items-center justify-between space-y-0 pb-4">
      <div>
        <h2 class="card-title text-base">Orders</h2>
        <p class="card-description"><%= s.total %> order<%= s.total === 1 ? '' : 's' %> matching this view</p>
      </div>
    </div>
    <div class="card-content-flush">
      <div class="table-wrap">
        <table class="table">
          <thead class="table-header">
            <tr class="table-row">
              <th class="table-head">Order</th>
              <th class="table-head">Channel</th>
              <th class="table-head">Type</th>
              <th class="table-head">Fulfillment</th>
              <th class="table-head">Print</th>
              <th class="table-head">Status</th>
              <th class="table-head text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="table-body">
            <% if (!orders || orders.length === 0) { %>
              <tr class="table-row">
                <td colspan="7" class="table-cell">
                  <div class="empty-wrap">
                    <p class="empty-title">No orders found</p>
                    <p class="empty-desc">Try a different filter, search term, or date.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% for (var i = 0; i < orders.length; i++) { %>
                <%- include('order-row', { order: orders[i] }) %>
              <% } %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('foot-scripts') %>
