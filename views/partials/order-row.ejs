<% var o = order; %>
<tr
  class="<%= o.isComplete ? 'table-row-muted' : 'table-row' %><%= o.needs_arrangement && !o.isComplete ? ' table-row-highlight' : '' %>"
  data-order-id="<%= o._id %>"
>
  <td class="table-cell">
    <div class="order-primary">#<%= o.order_number %></div>
    <div class="order-secondary"><%= o.customerName %></div>
    <% if (o.totalDisplay) { %>
      <div class="order-secondary tabular-nums"><%= o.totalDisplay %><% if (o.updatedRelative) { %> · <%= o.updatedRelative %><% } %></div>
    <% } %>
  </td>
  <td class="table-cell">
    <% if (o.channelKey === 'online') { %>
      <span class="badge-info"><%= o.channelLabel %></span>
    <% } else { %>
      <span class="badge-secondary"><%= o.channelLabel %></span>
    <% } %>
  </td>
  <td class="table-cell">
    <% if (o.needs_arrangement) { %>
      <span class="badge-warning">Arrangement</span>
    <% } else { %>
      <span class="badge-secondary">Other</span>
    <% } %>
  </td>
  <td class="table-cell">
    <div class="order-primary"><%= o.fulfillmentMethod %></div>
    <% if (o.fulfillmentDate || o.fulfillmentTime) { %>
      <div class="order-secondary">
        <% if (o.fulfillmentDate) { %><%= o.fulfillmentDate %><% } %>
        <% if (o.fulfillmentDate && o.fulfillmentTime) { %> · <% } %>
        <% if (o.fulfillmentTime) { %><%= o.fulfillmentTime %><% } %>
      </div>
    <% } %>
  </td>
  <td class="table-cell">
    <% if (o.isPrinted) { %>
      <span class="badge-success" title="<%= o.printedTitle || '' %>"><%= o.printedLabel %></span>
    <% } else if (o.isPrintQueued) { %>
      <span class="badge-secondary" title="<%= o.printedTitle || '' %>"><%= o.printedLabel %></span>
    <% } else if (o.isPrintFailed) { %>
      <span class="badge-destructive" title="<%= o.printedTitle || '' %>"><%= o.printedLabel %></span>
      <% if (o.print_error) { %>
        <div class="order-secondary text-destructive mt-1" title="<%= o.printedTitle || '' %>">
          <%= o.print_error.length > 80 ? o.print_error.slice(0, 80) + '…' : o.print_error %>
        </div>
      <% } %>
    <% } else { %>
      <span class="badge-outline">Not printed</span>
    <% } %>
  </td>
  <td class="table-cell">
    <% if (o.isComplete) { %>
      <span class="badge-success">Complete</span>
    <% } else { %>
      <span class="badge-warning">Pending</span>
    <% } %>
  </td>
  <td class="table-cell">
    <div class="action-group">
      <a href="/order/reprint/pdf/<%= o._id %>" class="<%= o.isPrintFailed ? 'btn-destructive' : 'btn-default' %> btn-sm"><%= o.isPrintFailed ? 'Retry print' : 'Print' %></a>
      <a href="https://admin.alsflowersmontgomery.com/order/pdf/<%= o._id %>" target="_blank" rel="noopener" class="btn-outline btn-sm">PDF</a>
      <a href="/order/edit/<%= o._id %>" class="btn-outline btn-sm">Edit</a>
      <% if (o.isComplete) { %>
        <button type="button" class="btn-ghost btn-sm js-order-status" data-status="pending" data-order-id="<%= o._id %>">Reopen</button>
      <% } else { %>
        <button type="button" class="btn-secondary btn-sm js-order-status" data-status="complete" data-order-id="<%= o._id %>">Complete</button>
      <% } %>
    </div>
  </td>
</tr>
